# Runtime mode: mock or live
COMMUTE_PROVIDER_MODE=mock
# Data environment: dev, test, demo, self_test, prod
COMMUTE_ENVIRONMENT=dev
# Map provider keys. Keep real values only in .env or shell environment.
AMAP_WEB_KEY=
BAIDU_WEB_KEY=
QQ_MAP_KEY=
# Optional server settings
COMMUTE_SERVER_HOST=127.0.0.1
COMMUTE_SERVER_PORT=8000
COMMUTE_METRICS_TOKEN=
# Optional local-only storage overrides
COMMUTE_ANALYTICS_LOG_PATH=
COMMUTE_FEEDBACK_DB_PATH=
COMMUTE_EXPERIMENT_LOG_PATH=

